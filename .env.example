# Environment Variables for Render Deployment
# 
# These variables should be configured in the Render dashboard:
# Dashboard → Your Service → Environment → Add Environment Variable
#
# DO NOT create a .env file locally - this project deploys to Render cloud
# where environment variables are managed through their dashboard.

# ============================================
# AIVEN MYSQL DATABASE CONFIGURATION
# ============================================
# Get these values from your Aiven MySQL service dashboard
# Aiven Console → Services → Your MySQL Service → Overview

DB_HOST=your-project-mysql.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASS=your-secure-password-here
DB_NAME=defaultdb

# ============================================
# SERVER CONFIGURATION
# ============================================
# Render automatically assigns PORT, but you can override if needed
PORT=10000
